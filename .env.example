# Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Gmail over IMAP. IMAP_PASSWORD must be a 16-character app password
# (Google Account -> Security -> 2-Step Verification -> App passwords), not your normal password.
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional overrides
# CLASSIFY_MODEL=claude-haiku-5-5
# EXTRACT_MODEL=claude-sonnet-5-5
# EXTRACT_EFFORT=medium
# REVIEW_THRESHOLD=0.8
# DATA_DIR=data
